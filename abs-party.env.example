# ── Required ──────────────────────────────────────────────────────────────────
# Base URL of your Audiobookshelf instance (no trailing slash)
ABS_BASE_URL=https://abs.example.com

# ── Network ───────────────────────────────────────────────────────────────────
# Bind address. Use PORT as a simpler alternative (e.g. PORT=3456).
BIND=0.0.0.0:3456
# PORT=3456

# ── Paths ─────────────────────────────────────────────────────────────────────
# Where the compiled Vue SPA lives. Matches the systemd ReadWritePaths entry.
STATIC_DIR=/opt/abs-party/static

# ── Logging ───────────────────────────────────────────────────────────────────
# Tracing filter. Use abs_party=debug for verbose output.
RUST_LOG=abs_party=info

# ── SAML single sign-on (optional; written for Authentik) ──────────────────────
# Setting one of the two metadata variables turns SAML on. See README "SAML sign-in".
# SAML_IDP_METADATA_URL=https://auth.example.com/api/v3/providers/saml/<id>/metadata/?download
# SAML_IDP_METADATA_FILE=/etc/abs-party/idp-metadata.xml
# Public https URL of this party server. ACS is $PUBLIC_URL/auth/saml/acs.
# PUBLIC_URL=https://party.example.com
# ABS API key of a dedicated ABS *admin* (not root) user. Prefer the _FILE form.
# ABS_ADMIN_API_KEY_FILE=/etc/abs-party/abs-admin-api-key
# SAML attribute holding the ABS username; "NameID" uses the subject NameID instead.
# SAML_USERNAME_ATTRIBUTE=http://schemas.goauthentik.io/2021/02/saml/username
# SAML_SP_ENTITY_ID=https://party.example.com/auth/saml/metadata
# SSO_KEY_TTL_HOURS=2160  (90 days; renewed on any day the sign-in is used)
# SAML_LOGIN_LABEL=Sign in with Authentik
# Set to 0 to hide the ABS password sign-in once SAML works.
# LOCAL_LOGIN=1

# ── Development / testing only ────────────────────────────────────────────────
# Set to 1 to skip ABS token validation. NEVER enable in production.
# BYPASS_AUTH=0
